APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Web realtime. `log` is the safe local default and needs no socket server.
# Set to `reverb` and provide the app id/key/secret to enable private channels.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Branded email presentation. The logo must be a public HTTPS URL in production.
# DUKAVO_EMAIL_LOGO_URL=https://app.dukavo.com/images/email/dukavo-logo.png
DUKAVO_EMAIL_LOGO_WIDTH=168
DUKAVO_SUPPORT_EMAIL="support@dukavo.com"
# Shared secret for the provider delivery/bounce/complaint webhook.
# DUKAVO_EMAIL_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Notifications. Mail is enabled by default; WhatsApp is configuration-ready but
# disabled until an approved template and a destination-bound transport both
# exist, so its deliveries are recorded as skipped instead of being faked.
DUKAVO_NOTIFICATION_MAIL=true
DUKAVO_NOTIFICATION_WHATSAPP=false
DUKAVO_NOTIFICATION_WHATSAPP_TEMPLATE=
DUKAVO_NOTIFICATION_WHATSAPP_LANGUAGE=en
DUKAVO_NOTIFICATION_REQUIRE_VERIFIED_EMAIL=true
DUKAVO_NOTIFICATION_RETRY_TIMES=3
# Retention windows (days) for read, archived and inactive device rows.
DUKAVO_NOTIFICATION_RETENTION_READ_DAYS=180
DUKAVO_NOTIFICATION_RETENTION_ARCHIVED_DAYS=30
DUKAVO_NOTIFICATION_DEVICE_RETENTION_DAYS=180
# Platform broadcast pacing: recipients per batch and jobs per minute.
DUKAVO_NOTIFICATION_BROADCAST_CHUNK=250
DUKAVO_NOTIFICATION_BROADCAST_PER_MINUTE=600

# Firebase Cloud Messaging. FCM only transports a notification whose history
# already lives in MySQL. Keep the service-account JSON out of git: point
# FIREBASE_CREDENTIALS at a mounted file, or inject the document (raw or
# base64) through FIREBASE_CREDENTIALS_JSON. `DUKAVO_NOTIFICATION_PUSH` must be
# true as well; missing project/credentials makes push report unavailable.
DUKAVO_NOTIFICATION_PUSH=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_HTTP_TIMEOUT=10

# Destination for public contact-form submissions. Falls back to the outgoing
# mail sender address when empty.
DUKAVO_CONTACT_EMAIL=

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# AI (Grok / xAI). The API key is server-only and must never reach the frontend.
# When it is absent, AI is disabled and every AI endpoint answers 503; the rest
# of Dukavo keeps working. See config/ai.php for the full set of overrides.
GROK_API_KEY=
GROK_MODEL=grok-4.7
GROK_BASE_URL=https://api.x.ai/v1
# AI_ENABLED=false
# AI_TIMEOUT=60
# AI_RATE_PER_MINUTE=20

# WhatsApp Cloud API (Meta). Every value here is server-side only and must
# never be copied into the frontend, a log line or an API response.
#   cloud_api_version   a supported Graph API version, e.g. v26.0
#   cloud_api_token     permanent/system-user access token from Meta — paste
#                       locally, never commit it
#   phone_number_id     sending number id from the WhatsApp > API setup panel
#   business_account_id WhatsApp Business Account (WABA) id
#   webhook_verify_token  any long random string you invent; enter the SAME
#                       value in Meta's webhook configuration
#   app_secret          App Secret from Meta for Developers > App settings.
#                       Required for X-Hub-Signature-256 validation; while it
#                       is empty the webhook refuses POST deliveries.
#   api_base_url        Graph API host, non-secret
WHATSAPP_CLOUD_API_VERSION=v26.0
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_MESSAGING_WINDOW_HOURS=24
WHATSAPP_MEDIA_MAX_BYTES=26214400
WHATSAPP_MEDIA_HOSTS=lookaside.fbsbx.com,*.fbcdn.net,*.whatsapp.net
